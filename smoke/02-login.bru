meta {
  name: Authentication
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ServiceModel/AuthService.svc/Login
  body: json
  auth: none
}

headers {
  Content-Type: application/json; charset=utf-8
  ForceUseSession: true
}

body:json {
  {
    "UserName": "{{username}}",
    "UserPassword": "{{password}}"
  }
}

script:post-response {
  const raw = res.getHeader("set-cookie");

  const cookies = Array.isArray(raw)
    ? raw.join("\n")
    : String(raw || "");

  function getCookie(name) {
    const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(escaped + "=([^;\\r\\n,]+)");
    const match = cookies.match(regex);

    return match ? match[1] : null;
  }

  const bpmcsrf = getCookie("BPMCSRF");
  const aspxauth = getCookie(".ASPXAUTH");
  const bpmloader = getCookie("BPMLOADER");
  const userName = getCookie("UserName");

  if (!bpmcsrf) {
    throw new Error("BPMCSRF cookie was not returned by Creatio");
  }

  bru.setVar("bpmcsrf", bpmcsrf);

  const cookieHeader = [];

  if (bpmloader) {
    cookieHeader.push("BPMLOADER=" + bpmloader);
  }

  if (aspxauth) {
    cookieHeader.push(".ASPXAUTH=" + aspxauth);
  }

  cookieHeader.push("BPMCSRF=" + bpmcsrf);

  if (userName) {
    cookieHeader.push("UserName=" + userName);
  }

  bru.setVar("creatioCookies", cookieHeader.join("; "));
}

tests {
  test("Authentication returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Authentication succeeded", function() {
    const body = res.getBody();

    expect(body).to.have.property("Code");
    expect(body.Code).to.equal(0);
  });

  test("Authentication creates session cookies", function() {
    const cookies = String(res.getHeader("set-cookie") || "");

    expect(cookies).to.contain("BPMCSRF");
  });
}