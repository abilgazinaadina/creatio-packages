pipeline {

    agent {
        label 'docker-agent'
    }


    parameters {

        string(
            name: 'BRANCH',
            defaultValue: '',
            description: 'Git branch for the temporary stand'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag / short commit SHA'
        )

        string(
            name: 'TTL_HOURS',
            defaultValue: '24',
            description: 'Stand lifetime in hours'
        )
    }


    environment {

        REPOSITORY = 'https://github.com/abilgazinaadina/creatio-packages.git'

        NAMESPACE = 'stands'

        CHART = './charts/stand'
    }


    stages {


        stage('Checkout') {

            steps {

                deleteDir()

                git(
                    branch: "${params.BRANCH}",
                    url: "${env.REPOSITORY}"
                )
            }
        }


        stage('Validate parameters') {

            steps {

                script {

                    if (!params.BRANCH?.trim()) {
                        error('BRANCH parameter is required')
                    }

                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG parameter is required')
                    }

                    if (!params.TTL_HOURS?.trim()) {
                        error('TTL_HOURS parameter is required')
                    }


                    echo """
Branch:    ${params.BRANCH}
Image tag: ${params.IMAGE_TAG}
TTL:       ${params.TTL_HOURS} hours
"""
                }
            }
        }


        stage('Prepare stand names') {

            steps {

                script {

                    env.SLUG = sh(
                        script: "sh ./scripts/slug.sh '${params.BRANCH}'",
                        returnStdout: true
                    ).trim()


                    env.RELEASE_NAME = "stand-${env.SLUG}"

                    env.DB_NAME = "stand_${env.SLUG.replace('-', '_')}"

                    env.HOST_NAME = "${env.SLUG}.localtest.me"


                    env.REDIS_DB = sh(
                        script: "sh ./scripts/allocate-redis.sh '${env.RELEASE_NAME}'",
                        returnStdout: true
                    ).trim()


                    echo """
                    ----------------------------------------
                    Stand configuration

                    Branch:       ${params.BRANCH}
                    Slug:         ${env.SLUG}
                    Release:      ${env.RELEASE_NAME}
                    Database:     ${env.DB_NAME}
                    Redis DB:     ${env.REDIS_DB}
                    Host:         ${env.HOST_NAME}
                    Image tag:    ${params.IMAGE_TAG}
                    TTL:          ${params.TTL_HOURS}h
                    ----------------------------------------
                    """
                }
            }
        }


        stage('Check Kubernetes') {

            steps {

                sh """
                    kubectl get nodes

                    kubectl get namespace '${env.NAMESPACE}'
                """
            }
        }


        stage('Clone database') {

            steps {

                sh """
                    sh ./scripts/clone-db.sh \
                      '${params.BRANCH}' \
                      '${params.IMAGE_TAG}'
                """
            }
        }


        stage('Deploy stand') {

            steps {

                sh """
                    helm upgrade --install '${env.RELEASE_NAME}' '${env.CHART}' \
                      --namespace '${env.NAMESPACE}' \
                      --create-namespace \
                      --set-string image.tag='${params.IMAGE_TAG}' \
                      --set-string branch='${params.BRANCH}' \
                      --set-string database.name='${env.DB_NAME}' \
                      --set redis.database=${env.REDIS_DB} \
                      --set-string route.host='${env.HOST_NAME}' \
                      --set ttlHours=${params.TTL_HOURS} \
                      --force-conflicts \
                      --wait \
                      --timeout 10m
                """
            }
        }


        stage('Check deployment') {

            steps {

                sh """
                    echo "Checking deployment..."

                    kubectl get deployment \
                      '${env.RELEASE_NAME}' \
                      -n '${env.NAMESPACE}'


                    echo "Checking pods..."

                    kubectl get pods \
                      -n '${env.NAMESPACE}' \
                      -l app='${env.RELEASE_NAME}' \
                      -o wide


                    echo "Waiting for rollout..."

                    kubectl rollout status \
                      deployment/'${env.RELEASE_NAME}' \
                      -n '${env.NAMESPACE}' \
                      --timeout=5m


                    echo "Checking service..."

                    kubectl get service \
                      '${env.RELEASE_NAME}' \
                      -n '${env.NAMESPACE}'


                    echo "Checking HTTPRoute..."

                    kubectl get httproute \
                      '${env.RELEASE_NAME}' \
                      -n '${env.NAMESPACE}'
                """
            }
        }

    }


    post {


        success {

            echo """
----------------------------------------
Stand deployed successfully

Branch:    ${params.BRANCH}
Release:   ${env.RELEASE_NAME}
Host:      http://${env.HOST_NAME}:8080
Database:  ${env.DB_NAME}
Redis DB:  ${env.REDIS_DB}
Image tag: ${params.IMAGE_TAG}
TTL:       ${params.TTL_HOURS}h
----------------------------------------
"""
        }


        failure {

            echo 'Stand deployment failed.'
        }

    }
}